# AD Factory — copy to .env and fill only what you need. Never commit .env.
# Nothing here is required for Phase 1: the whole pipeline runs locally and for free.

# Headless browser used by Remotion. Leave empty on a normal machine (Remotion downloads its own).
# In a locked-down container point it at a local headless shell, e.g.
# REMOTION_BROWSER=/opt/pw-browsers/chromium_headless_shell-1194/chrome-linux/headless_shell
REMOTION_BROWSER=

# Render concurrency (number of Chrome tabs). Empty = Remotion default (half the CPU cores).
RENDER_CONCURRENCY=

# --- Paid providers: DISABLED until the owner approves a budget (see COSTS.md) ---
# Phase 3 (voice-over). Not read by any code yet.
ELEVENLABS_API_KEY=
# Hard cap per ad, in USD, for any paid call. 0 = paid calls are refused.
PAID_BUDGET_USD_PER_AD=0
